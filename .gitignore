# ---------- macOS app ----------
# Xcode build artifacts (unanchored — catches /macos/build/, /build/, anywhere)
build/
DerivedData/
*.xcuserstate
xcuserdata/
*.xcscmblueprint
*.xccheckout
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# Generated Xcode project (source of truth is macos/project.yml)
*.xcodeproj
*.xcworkspace

# Generated Info.plist (XcodeGen writes to macos/Hark/Generated/)
macos/Hark/Generated/

# Swift Package Manager
.build/
.swiftpm/
Package.resolved

# Bun / Node (Sidecar/)
macos/Sidecar/node_modules/
macos/Sidecar/dist/
macos/Sidecar/bun.lockb.local

# Compiled sidecar artifact (bundled at build time)
macos/Hark/Resources/Sidecar/

# Notarization artifacts
*.dmg
*.pkg
notarize-output/

# ---------- Web (Next.js) ----------
web/.next/
web/out/
web/node_modules/
web/.vercel/
web/.env*.local

# ---------- Video (Remotion) ----------
video/node_modules/
video/out/
video/.remotion/

# ---------- General ----------
# macOS
.DS_Store
*.swp
*~

# Local config + secrets
*.xcconfig.local
.env
.env.local

# IDE
.vscode/
.idea/
.cursor/

# Claude Code per-dev settings (project-level .claude/settings.json may be committed)
.claude/settings.local.json
.claude/plans/

# Logs and crash reports
*.log
crash-reports/
